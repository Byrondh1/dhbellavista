# Copiar a .env.local para desarrollo. En Vercel se configuran como
# Environment Variables del proyecto (una por evento donde aplique).

# Evento activo (los scripts npm dev:/build: ya la definen)
# NEXT_PUBLIC_EVENT=downhill-la-cantera-2026

# URL pública del sitio (dominio final). Si falta, se usa VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://downhill.midominio.ec

# --- Módulo de inscripciones (registrationCta.mode = "modal") ---
# Proyecto Supabase → Settings → API. El service role SOLO va en el servidor:
# nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- M2 (correos): pendiente ---
# RESEND_API_KEY=re_...
